# Environment variables for enquiry email

# Leave these unset to use the mailto fallback.
# When both values below are set, /api/contact sends mail through Resend.
# Never commit real keys. This file is a template only.

# API key from https://resend.com
RESEND_API_KEY=

# A verified sender on your Resend domain, for example:
# Zenbyte Technologies <enquiry@zenbytetechnologies.com>
CONTACT_FROM_EMAIL=

# Optional. Defaults to uday@zenbytetechnologies.com
CONTACT_TO_EMAIL=uday@zenbytetechnologies.com
